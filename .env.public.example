# Copier en .env.public, renseigner, puis lancer :
# docker compose -f docker-compose.public.yml --env-file .env.public up -d --build

# Host:port de l'API du serveur mise central, joignable DEPUIS ce poste (pas "api:80" — ce nom
# n'existe que dans le réseau Docker du docker-compose complet). En LAN : l'IP locale du serveur et
# le port publié par son service `api` (8000 par défaut, voir docker-compose.yml). À distance : il
# faut un VPN ou un tunnel exposant ce port, pas juste l'IP publique du serveur.
API_UPSTREAM=192.168.1.10:8000
