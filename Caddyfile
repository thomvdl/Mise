# Reverse proxy de production pour MISE — HTTPS automatique (Let's Encrypt) sur les 3 domaines.
# Les valeurs {$...} sont lues dans l'environnement du conteneur caddy (voir .env / env_file
# dans docker-compose.prod.yml). Voir DEPLOY.md pour la configuration DNS attendue.
{
	email {$ACME_EMAIL}
}

# mise-public — l'app de la brigade au quotidien (fiches, étiquettes, PWA).
{$MISE_PUBLIC_DOMAIN} {
	reverse_proxy public:80
}

# mise-dashboard — back-office du chef (réservé au rôle admin).
{$MISE_DASHBOARD_DOMAIN} {
	reverse_proxy dashboard:80
}

# mise-api — exposée directement (pas seulement en interne) car Laravel génère des URLs
# absolues pour les photos uploadées à partir d'APP_URL (Storage::disk('public')->url(...)) ;
# sans ce domaine joignable, les images des fiches techniques/ingrédients seraient cassées.
{$MISE_API_DOMAIN} {
	reverse_proxy api:80
}
