# Copier ce fichier en ".env" (au même endroit, à côté de docker-compose.yml) puis
# ajuster les valeurs ci-dessous avant de lancer `docker compose up -d --build`.

# --- Base de données ---
DB_DATABASE=mise
DB_USERNAME=mise
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- Application (Laravel) ---
APP_NAME=MISE
APP_ENV=production
APP_DEBUG=false
# Adresse publique de l'API telle qu'accédée par un navigateur — sert notamment à générer les
# URLs des photos uploadées (fiches techniques / ingrédients). À changer si déployé ailleurs
# qu'en local (nom de domaine, IP du serveur...).
APP_URL=http://localhost:8000

# Clé de chiffrement Laravel (sessions, cookies, données chiffrées). Une valeur fonctionnelle
# est fournie ci-dessous pour un premier démarrage sans étape supplémentaire — pour un vrai
# déploiement, régénérez-en une à vous avec :
#   docker compose run --rm api php artisan key:generate --show
# et ne la changez plus ensuite (la changer invalide les sessions et tout ce qui a été chiffré
# avec l'ancienne clé).
APP_KEY=base64:IA49+nWdhKw3rQcOvN3Fv7veHoyt0G207Yg1E4PCC7E=

# --- Premier compte administrateur ---
# Créé automatiquement au premier démarrage (base vide uniquement — jamais recréé après coup,
# même si vous changez ces valeurs ensuite). Changez le mot de passe depuis la gestion des
# utilisateurs du dashboard une fois connecté.
ADMIN_NAME=admin
ADMIN_PASSWORD=password
