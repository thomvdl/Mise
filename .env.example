# Fichier .env unique pour tout le projet MISE (Docker et exécution native de mise-api partagent
# ce même fichier — voir mise-api/bootstrap/app.php). Copier ce fichier en ".env" (au même endroit,
# à côté de docker-compose.yml) puis ajuster les valeurs ci-dessous.

# --- Base de données ---
DB_CONNECTION=mysql
# 127.0.0.1 pour une exécution native de mise-api (artisan/tests hors Docker) — le port 3306 du
# conteneur "db" est publié sur l'hôte pour ça. Sans effet pour le conteneur "api" lui-même :
# docker-compose force DB_HOST=db pour qu'il passe par le réseau interne du compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mise
DB_USERNAME=mise
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- Application (Laravel) ---
APP_NAME=MISE
APP_ENV=production
APP_DEBUG=false
# Adresse publique de l'API telle qu'accédée par un navigateur — sert notamment à générer les
# URLs des photos uploadées (fiches techniques / ingrédients). À changer si déployé ailleurs
# qu'en local (nom de domaine, IP du serveur...).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Clé de chiffrement Laravel (sessions, cookies, données chiffrées). Une valeur fonctionnelle
# est fournie ci-dessous pour un premier démarrage sans étape supplémentaire — pour un vrai
# déploiement, régénérez-en une à vous avec :
#   docker compose run --rm api php artisan key:generate --show
# et ne la changez plus ensuite (la changer invalide les sessions et tout ce qui a été chiffré
# avec l'ancienne clé).
APP_KEY=base64:IA49+nWdhKw3rQcOvN3Fv7veHoyt0G207Yg1E4PCC7E=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Premier compte administrateur ---
# Créé automatiquement au premier démarrage (base vide uniquement — jamais recréé après coup,
# même si vous changez ces valeurs ensuite). Changez le mot de passe depuis la gestion des
# utilisateurs du dashboard une fois connecté.
ADMIN_NAME=Thomas
ADMIN_PASSWORD=1234abcd
