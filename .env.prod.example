# Fichier .env de PRODUCTION pour MISE — à copier en ".env" à la racine du projet, à côté de
# docker-compose.prod.yml, puis à remplir sérieusement (voir DEPLOY.md pour la procédure
# complète). Toutes les valeurs marquées CHANGEZ_MOI doivent l'être avant le premier démarrage —
# ce sont les valeurs par défaut de dev, sans intérêt de sécurité une fois exposées sur internet.

# --- Domaines (voir DEPLOY.md pour la configuration DNS attendue : 3 enregistrements A) ---
# mise-api est exposée directement (pas juste en interne) car les URLs de photos uploadées sont
# générées à partir d'APP_URL — voir la remarque dans le Caddyfile.
MISE_PUBLIC_DOMAIN=app.CHANGEZ_MOI.fr
MISE_DASHBOARD_DOMAIN=admin.CHANGEZ_MOI.fr
MISE_API_DOMAIN=api.CHANGEZ_MOI.fr
# Adresse à laquelle Let's Encrypt peut vous notifier (expiration, problème de renouvellement).
ACME_EMAIL=CHANGEZ_MOI@example.com

# --- Base de données ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mise
DB_USERNAME=mise
# Mots de passe réels et distincts l'un de l'autre — un VPS exposé sur internet n'a pas le même
# modèle de risque qu'une machine de dev locale. Générer par exemple avec :
#   openssl rand -base64 24
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
DB_ROOT_PASSWORD=CHANGEZ_MOI_autre_mot_de_passe_fort

# --- Application (Laravel) ---
APP_NAME=MISE
APP_ENV=production
APP_DEBUG=false
# Doit être le domaine public de l'API (voir MISE_API_DOMAIN ci-dessus), en https:// — sert à
# générer les URLs des photos uploadées (fiches techniques/ingrédients). Une valeur incorrecte
# ici casse silencieusement toutes les images du site.
APP_URL=https://api.CHANGEZ_MOI.fr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Clé de chiffrement Laravel — générez-en une à vous, propre à ce déploiement, avant le premier
# démarrage (ne réutilisez jamais celle de dev/.env.example) :
#   docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
# puis collez le résultat ci-dessous. Ne la changez plus ensuite (la changer invalide les
# sessions et tout ce qui a été chiffré avec l'ancienne clé).
APP_KEY=CHANGEZ_MOI_generee_avec_artisan_key_generate

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Désactive l'ExampleDataSeeder (fiches/menus de démonstration) — inutile et encombrant en prod.
DEMO=false

# --- Premier compte administrateur ---
# Créé automatiquement au premier démarrage (base vide uniquement — jamais recréé après coup).
# Changez IMPÉRATIVEMENT le mot de passe depuis la gestion des utilisateurs du dashboard dès la
# première connexion, même après avoir changé ces valeurs par défaut.
ADMIN_NAME=CHANGEZ_MOI
ADMIN_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
