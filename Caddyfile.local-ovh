# Reverse proxy pour un hébergement LOCAL (mini PC en cuisine, non exposé sur internet) — variante
# domaine chez OVH. À copier en "Caddyfile.local" avant de démarrer (voir DEPLOY.md).
#
# Contrairement au Caddyfile de la variante VPS (validation HTTP-01, qui exige un serveur
# joignable depuis internet sur le port 80), ce fichier valide le certificat par DNS-01 : Caddy
# prouve la possession du domaine via une entrée DNS chez OVH, sans jamais avoir besoin d'être
# joignable depuis l'extérieur. Le domaine peut donc pointer vers l'IP locale du mini PC.
#
# Identifiants OVH à créer sur https://api.ovh.com/createToken/ (droits GET/PUT/POST/DELETE sur
# /domain/zone/*) — voir DEPLOY.md pour le détail. OVH_ENDPOINT vaut "ovh-eu" pour un compte
# européen (le cas le plus courant), "ovh-ca" pour un compte canadien.
{
	email {$ACME_EMAIL}
}

(dns_ovh) {
	tls {
		dns ovh {
			endpoint {$OVH_ENDPOINT}
			application_key {$OVH_APPLICATION_KEY}
			application_secret {$OVH_APPLICATION_SECRET}
			consumer_key {$OVH_CONSUMER_KEY}
		}
	}
}

# mise-public — l'app de la brigade au quotidien (fiches, étiquettes, PWA).
{$MISE_PUBLIC_DOMAIN} {
	import dns_ovh
	reverse_proxy public:80
}

# mise-dashboard — back-office du chef (réservé au rôle admin).
{$MISE_DASHBOARD_DOMAIN} {
	import dns_ovh
	reverse_proxy dashboard:80
}

# mise-api — exposée directement car Laravel génère les URLs des photos uploadées à partir
# d'APP_URL (Storage::disk('public')->url(...)) ; sans ce domaine joignable, les images des
# fiches techniques/ingrédients seraient cassées.
{$MISE_API_DOMAIN} {
	import dns_ovh
	reverse_proxy api:80
}
