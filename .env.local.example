# Fichier .env pour un hébergement LOCAL (mini PC en cuisine) — à copier en ".env" à la racine
# du projet, à côté de docker-compose.local.yml. Voir DEPLOY.md pour la procédure complète.
# Toutes les valeurs CHANGEZ_MOI doivent l'être avant le premier démarrage.

# --- Domaines ---
# Un vrai domaine, mais qui pointe vers l'IP LOCALE du mini PC (pas une IP publique) — voir
# DEPLOY.md pour la configuration DNS attendue (3 enregistrements A vers l'IP du mini PC sur le
# réseau de l'hôtel). Réservez une IP fixe pour le mini PC depuis votre routeur avant de créer
# ces enregistrements, sans quoi ils cesseraient de pointer au bon endroit après un redémarrage.
MISE_PUBLIC_DOMAIN=app.CHANGEZ_MOI.fr
MISE_DASHBOARD_DOMAIN=admin.CHANGEZ_MOI.fr
MISE_API_DOMAIN=api.CHANGEZ_MOI.fr
# Adresse à laquelle Let's Encrypt peut vous notifier (expiration, problème de renouvellement).
ACME_EMAIL=CHANGEZ_MOI@example.com

# --- Identifiants DNS (un seul bloc à remplir, selon Caddyfile.local choisi) ---

# Si domaine chez OVH (Caddyfile.local-ovh) : créez un jeton sur
# https://api.ovh.com/createToken/ avec les droits GET/PUT/POST/DELETE sur /domain/zone/*.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Si domaine chez Hostinger (Caddyfile.local-hostinger) : créez un jeton depuis
# https://hpanel.hostinger.com/profile/api
HOSTINGER_API_TOKEN=

# --- Base de données ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mise
DB_USERNAME=mise
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
DB_ROOT_PASSWORD=CHANGEZ_MOI_autre_mot_de_passe_fort

# --- Application (Laravel) ---
APP_NAME=MISE
APP_ENV=production
APP_DEBUG=false
# Doit correspondre exactement à https:// + MISE_API_DOMAIN ci-dessus — sert à générer les URLs
# des photos uploadées. Une valeur incorrecte casse silencieusement toutes les images du site.
APP_URL=https://api.CHANGEZ_MOI.fr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Générez votre propre clé avant le premier démarrage (ne réutilisez jamais celle de dev) :
#   docker compose -f docker-compose.local.yml run --rm api php artisan key:generate --show
APP_KEY=CHANGEZ_MOI_generee_avec_artisan_key_generate

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DEMO=false

# --- Premier compte administrateur ---
ADMIN_NAME=CHANGEZ_MOI
ADMIN_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
